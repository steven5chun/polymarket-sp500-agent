# LLM Provider: "openai", "qwen", or "ollama"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Qwen (Alibaba Cloud International) Configuration
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_MODEL=qwen3.7-plus
QWEN_API_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Ollama Configuration
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Polymarket API Endpoints
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Liquidity Filter Threshold (minimum volume in USD)
MIN_LIQUIDITY_USD=50000
